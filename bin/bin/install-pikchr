#!/bin/bash

set -euo pipefail
set -x

# Get the latest file from https://pikchr.org/home/file/pikchr.c?ci=trunk
curl "https://pikchr.org/home/raw/157276b22395ca1423bce1532e07d56fc3597cc813bf5cd46294c32181bbe1dc?at=pikchr.c" > /tmp/pikchr.c

pushd /tmp || exit
gcc -c pikchr.c
gcc -DPIKCHR_SHELL -o pikchr pikchr.c -lm
mv pikchr /usr/local/bin/pikchr
popd || exit
